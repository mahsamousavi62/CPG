{
  "App": {
    "CorsOrigins": "http://localhost:8080",
    "EnableSwagger": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200;",
          "indexFormat": "logstash-Daryaftyar-{0:yyyy-MM-dd}",
          "templateName": "Daryaftyarapi-events-template",
          "autoRegisterTemplate": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DaryaftyarConnectionString": "Server=172.16.10.114; Database=Daryaftyar_test; user Id=Dev;password=123@abc"
  },
  "JwtConfig": {
    "Secret": "PDv7DrqznYL6nv7DrqzjnQYO9JxIsWdcjnQYL6nu0f",
    "ExpirationInMinutes": 1440
  },
  "Infrastructure": {
    "GraphQL": {
      "EndpointUrl": "/api/graphql"
    }
  }
}
